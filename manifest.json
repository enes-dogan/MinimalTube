{
  "manifest_version": 3,
  "name": "MinimalTube Player",
  "version": "1.2.0",
  "key": "",
  "description": "Right-click a YouTube link and play it in a clean, minimal player. No YouTube page ever loads.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "nativeMessaging",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "system.display"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.youtube-nocookie.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["open.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content-youtube.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MinimalTube",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
